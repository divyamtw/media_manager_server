{
  "compilerOptions": {
    /* File Layout */
    "rootDir": ".",
    "outDir": "./dist",

    /* Environment */
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    /* Output */
    "sourceMap": true,

    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Module */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* Misc */
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "drizzle.config.ts"]
}
